#######################################
#### Set home directory of package ####
#######################################

PW_PATH = $(shell realpath ../)


############################################################
#### Set generic compiler options and link to libraries ####
############################################################

# Laptop:     source /home/cbroderick/Install/Intel_MKL_2019/bin/compilervars.sh intel64
# Tyndall PC: source /opt/intel/compilers_and_libraries_2017/linux/bin/compilervars.sh intel64

CC           =  mpiicc
CC_FLAGS     = -O3 -xHost -std=c11 -Wall -DMKL_ILP64
CLIB_FLAGS   = -lyaml -lmkl_scalapack_ilp64 -lmkl_cdft_core -lmkl_intel_ilp64 -lmkl_intel_thread -lmkl_core -lmkl_blacs_intelmpi_ilp64 -liomp5 -lpthread -lm -ldl
HEADER_FLAGS = -I${MKLROOT}/include -I$(PW_PATH)/source/parameters/ # Path to directory containing material parameter header file (material_parameters.h)
OPENMP_FLAGS = -fopenmp
GSL_FLAGS    = -lgsl -lgslcblas


#######################################################
#### Set compilation variables for each executable ####
#######################################################

