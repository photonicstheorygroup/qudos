#################
#### Compile ####
#################

# Strain and band edge energy linescans - 8-band model

$(exec_8_band_linescan) : $(srcs_8_band_linescan)
	@echo ""
	@echo "Compiling: strain and band edge energy linescans, 8-band model - $(exec_8_band_linescan)"
	@echo ""
	$(CC) $(CC_FLAGS) $^ -o $@ $(HEADER_FLAGS) $(CLIB_FLAGS) $(LAPACK_FLAGS) $(GSL_FLAGS) $(OPENMP_FLAGS)
	@echo ""
	@echo "Compiled successfully: the executable $(exec_8_band_linescan) has been created in $(PW_PATH)/build/"
	@echo ""


# Plane wave expansion method - 8-band model

$(exec_8_band_pwem) : $(srcs_8_band_pwem)
	@echo ""
	@echo "Compiling: plane wave expansion method, 8-band model - $(exec_8_band_pwem)"
	@echo ""
	$(CC) $(CC_FLAGS) $^ -o $@ $(HEADER_FLAGS) $(CLIB_FLAGS) $(LAPACK_FLAGS) $(GSL_FLAGS) $(OPENMP_FLAGS)
