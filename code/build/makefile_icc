# Plane wave expansion method - 8-band model - memory calculator

$(exec_8_band_pwem_memory) : $(srcs_8_band_pwem_memory)
	@echo ""
	@echo "Compiling: plane wave expansion method memory, 8-band model - $(exec_8_band_pwem_memory)"
